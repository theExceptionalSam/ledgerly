# Server
PORT=4000
NODE_ENV=development

# Database — PostgreSQL connection string.
# Local dev:  postgresql://user:password@localhost:5432/ledgerly
# Supabase:   postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Render:     postgresql://user:password@dpg-xxx/render-db
DATABASE_URL=postgresql://localhost:5432/ledgerly

# Set to 'false' only for local dev without SSL. Managed hosts (Supabase, Render,
# Neon) require SSL and this should be left unset (defaults to SSL on).
# DB_SSL=false

# Frontend origins allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Generate strong secrets e.g. with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Email (Resend) — optional in dev; OTP codes are logged to the console if absent.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
